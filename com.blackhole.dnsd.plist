<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.blackhole.dnsd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/blackhole-dnsd</string>
        <string>-port</string>
        <string>53</string>
        <string>-exclusions</string>
        <string>/Library/Application Support/blackhole/exclusions.json</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/blackhole-dnsd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/blackhole-dnsd.log</string>
</dict>
</plist>
